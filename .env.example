# Disabled by default and ignored in every production build.
NEXT_PUBLIC_ENABLE_IDENTITY_PREVIEW=false

# Required by authentication APIs. Use at least 32 random characters.
AUTH_IP_HASH_KEY=

# Required to encrypt and deduplicate sensitive driver identity data.
DRIVER_DATA_PROTECTION_KEY=

# Optional private Google Drive document adapter. Keep values in Cloudflare Secrets.
DRIVER_DOCUMENTS_GOOGLE_SERVICE_ACCOUNT_EMAIL=
DRIVER_DOCUMENTS_GOOGLE_PRIVATE_KEY=
DRIVER_DOCUMENTS_GOOGLE_DRIVE_FOLDER_ID=

# Identity bootstrap is intentionally limited to development or staging.
BOOTSTRAP_TARGET=development
BOOTSTRAP_D1_DATABASE=
BOOTSTRAP_ADMIN_LOGIN_CODE=
BOOTSTRAP_ADMIN_DISPLAY_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_MUST_CHANGE_PASSWORD=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_LANGUAGE=ar
BOOTSTRAP_TEST_USERS_JSON=

# Optional local-only path used to isolate Wrangler D1 state during verification.
BOOTSTRAP_D1_PERSIST_TO=
BOOTSTRAP_WRANGLER_CONFIG=

# Required in addition to BOOTSTRAP_TARGET=staging.
BOOTSTRAP_CONFIRM_STAGING=
